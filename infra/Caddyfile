{$SITE_HOST} {
	# Compress normal responses only. Compressing text/event-stream buffers it, and the live run stream would stall.
	encode zstd gzip {
		match {
			header Content-Type text/html* text/css* text/plain* text/csv* application/json* application/javascript* image/svg+xml*
		}
	}
	handle /api/* {
		request_body {
			max_size 70MB
		}
		reverse_proxy api:8000
	}
	handle /mcp* {
		reverse_proxy mcp:8001
	}
	handle /mail* {
		reverse_proxy mailpit:8025
	}
	handle {
		reverse_proxy web:3000
	}
}
